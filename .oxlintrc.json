{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["packages/create-cms-app/templates/**", "packages/create-cms-app/dist/**"],
  "rules": {
    "curly": ["error", "all"],
    "typescript/consistent-type-definitions": ["error", "type"]
  },
  "env": {
    "builtin": true
  }
}
