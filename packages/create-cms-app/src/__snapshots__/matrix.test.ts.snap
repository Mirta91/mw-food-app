{
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "astro": "7.3.7",
    "contentful": "11.12.10",
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "contentful-management": "12.19.0",
    "contentful-migration": "5.1.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "^11.28.0",
    },
  },
  "engines": {
    "node": ">=24",
  },
  "name": "contentful-astro",
  "private": true,
  "scripts": {
    "build": "astro build",
    "check": "pnpm lint && pnpm format && pnpm check-types && pnpm test && pnpm test:smoke && pnpm check:docs",
    "check-types": "astro check",
    "check:docs": "node scripts/check-docs.ts",
    "cms:migrate": "node --env-file-if-exists=.env cms/migrate.ts",
    "dev": "astro dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node --env-file-if-exists=.env scripts/check-env.ts && node --env-file-if-exists=.env dist/server/entry.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.ts",
    "test:watch": "vitest --watch",
  },
  "type": "module",
  "version": "0.0.0",
}
`;

