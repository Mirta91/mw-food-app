---
import Layout from "../layouts/Layout.astro";
import { createExampleLoader } from "../lib/cms/client";

const example = await createExampleLoader(process.env)();
if (!example) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout>
  <main>
    <h1>{example.title}</h1>
    <p>{example.body}</p>
  </main>
</Layout>
