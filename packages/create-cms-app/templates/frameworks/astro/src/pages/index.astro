---
import Layout from "../layouts/Layout.astro";
import { fetchExample } from "../lib/cms/example";

const example = await fetchExample();
if (!example) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout>
  <main>
    <h1>{example.title}</h1>
    <p>{example.body}</p>
  </main>
</Layout>
