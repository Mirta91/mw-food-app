---
// The client is created here per request from process.env instead of through @sanity/astro:
// the integration's options live in astro.config.ts, which runs during `pnpm build`, so a later
// .env change would be ignored by `pnpm start`.
import { createClient } from "@sanity/client";
import Layout from "../layouts/Layout.astro";
import { apiVersion, fetchExample } from "../lib/cms/client";

const example = await fetchExample(
  createClient({
    projectId: process.env.SANITY_PROJECT_ID,
    dataset: process.env.SANITY_DATASET,
    apiVersion,
    useCdn: true,
  }),
);
if (!example) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout>
  <main>
    <h1>{example.title}</h1>
    <p>{example.body}</p>
  </main>
</Layout>
