---
// The client is created here per request from process.env instead of through @storyblok/astro:
// the integration's options live in astro.config.ts, which runs during `pnpm build`, so a later
// .env change would be ignored by `pnpm start`.
import StoryblokClient from "storyblok-js-client";
import Layout from "../layouts/Layout.astro";
import { fetchExample, type StoryblokApi, storyblokRegion } from "../lib/cms/client";

const example = await fetchExample(
  new StoryblokClient({
    accessToken: process.env.STORYBLOK_ACCESS_TOKEN,
    region: storyblokRegion(process.env),
  }) as StoryblokApi,
);
if (!example) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout>
  <main>
    <h1>{example.title}</h1>
    <p>{example.body}</p>
  </main>
</Layout>
