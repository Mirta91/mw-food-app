---
// The client is created here per request from process.env instead of through @storyblok/astro:
// the integration's options live in astro.config.ts, which runs during `pnpm build`, so a later
// .env change would be ignored by `pnpm start`.
import StoryblokClient from "storyblok-js-client";
import CmsStatus from "../components/CmsStatus.astro";
import Layout from "../layouts/Layout.astro";
import { fetchExample, requiredEnv, type StoryblokApi, storyblokRegion } from "../lib/cms/client";
import { loadCmsState, missingEnv } from "../lib/cms/state";

const state = await loadCmsState(missingEnv(requiredEnv, process.env), () =>
  fetchExample(
    new StoryblokClient({
      accessToken: process.env.STORYBLOK_ACCESS_TOKEN,
      region: storyblokRegion(process.env),
    }) as StoryblokApi,
  ),
);
---

<Layout><CmsStatus state={state} /></Layout>
