{
  "name": "cms-fe-scaffolding",
  "private": true,
  "bin": {
    "create-cms-app": "packages/create-cms-app/dist/cli.mjs"
  },
  "files": [
    "packages/create-cms-app/dist"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "setup:hooks": "git config core.hooksPath .githooks",
    "lint": "oxlint -c .oxlintrc.json",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "format": "oxfmt -c .oxfmtrc.json --check",
    "format:fix": "oxfmt -c .oxfmtrc.json",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:matrix": "node packages/create-cms-app/scripts/test-matrix.ts",
    "check": "turbo run lint format check-types test build && pnpm check:bundle && pnpm check:docs",
    "check:links": "lychee --offline --include-fragments --no-progress README.md AGENTS.md \"docs/**/*.md\"",
    "check:instructions": "node scripts/check-instruction-links.mjs",
    "check:docs": "pnpm check:links && pnpm check:instructions",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify:git-install": "VERIFY_TEMPLATE_FILES='common/.githooks/pre-commit common/_gitignore common/.oxlintrc.json cms/sanity/.env.example' sh packages/create-cms-app/scripts/verify-git-install.sh"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
